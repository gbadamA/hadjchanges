# Modèle des variables d'environnement de HadjChanges.
# Copier en `.env` et remplir. JAMAIS de vraie valeur dans ce fichier.
# Chaque brique lit son propre .env : api/.env, admin/.env.local, mobile/.env

# ---------------------------------------------------------------------------
# api/.env
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://hadjchanges:hadjchanges@localhost:54360/hadjchanges?schema=public"
PORT=3061
NODE_ENV=development

# Auth — générer avec: openssl rand -base64 48
JWT_ACCESS_SECRET="a-remplacer"
JWT_REFRESH_SECRET="a-remplacer-aussi"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# Origines autorisées (dashboard + Expo)
CORS_ORIGINS="http://localhost:3060,http://localhost:8081"

# Fichiers : disque local en dev, S3 en production
# local = disque de la machine (développement, un seul serveur)
# s3    = compartiment objet. ⚠️ Il doit être PRIVÉ : on y dépose des pièces
#         d'identité. Aucune URL publique ni pré-signée n'est distribuée, la
#         lecture passe toujours par l'API qui vérifie les droits.
STORAGE_DRIVER="local"          # local | s3
STORAGE_LOCAL_DIR="./uploads"
S3_ENDPOINT=""                  # vide = AWS ; sinon https://s3.fr-par.scw.cloud, http://localhost:9000…
S3_REGION="us-east-1"
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# Emails (Mailpit en dev)
SMTP_HOST="localhost"
SMTP_PORT=1036
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="HadjChanges <no-reply@hadjchanges.ci>"

# Notifications
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

# Métier
BASE_CURRENCY="XOF"
RATE_LOCK_MINUTES=30            # durée de validité du taux verrouillé
RATE_STALE_HOURS=12             # alerte « taux non mis à jour depuis X heures »
DEFAULT_DAILY_LIMIT_XOF=2000000
DEFAULT_MONTHLY_LIMIT_XOF=10000000
LCB_FT_THRESHOLD_XOF=5000000    # seuil de déclaration / alerte de conformité

# ---------------------------------------------------------------------------
# admin/.env.local
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:3061"

# ---------------------------------------------------------------------------
# mobile/.env  (Expo — préfixe EXPO_PUBLIC_ obligatoire)
# ⚠️ `localhost` ne veut rien dire depuis un téléphone : mettre l'IP Wi-Fi du PC.
# ---------------------------------------------------------------------------
EXPO_PUBLIC_API_URL="http://192.168.1.10:3061"
