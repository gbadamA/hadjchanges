# ─────────────────────────────────────────────────────────────────────────────
# EN DÉVELOPPEMENT : NE RIEN METTRE.
# L'application déduit l'adresse de l'API de l'hôte Metro (mobile/src/api-url.ts).
# Émulateur Android, téléphone réel en Wi-Fi, simulateur iOS : ça marche sans
# toucher à ce fichier, y compris quand l'IP du poste change.
#
# EN BUILD (APK / store) : OBLIGATOIRE. Sans hôte Metro, l'auto-détection
# retombe sur la machine locale, qui n'existe pas pour un utilisateur final.
# EXPO_PUBLIC_API_URL="https://api.hadjchanges.ci"
