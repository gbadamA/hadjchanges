{
  "expo": {
    "name": "HadjChanges",
    "slug": "hadjchanges",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "hadjchanges",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ci.hadjchanges.app"
    },
    "android": {
      "package": "ci.hadjchanges.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "HadjChanges accède à vos photos pour importer votre pièce d'identité et vos reçus de paiement.",
          "cameraPermission": "HadjChanges accède à l'appareil photo pour photographier votre pièce d'identité et vos reçus."
        }
      ],
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6fdab252-4731-4ce7-8e88-a64e2d135bf8"
      }
    },
    "icon": "./assets/icon.png"
  }
}
