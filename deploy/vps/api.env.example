# Secrets de l'API HadjChanges — à déposer en /etc/hadjchanges/api.env
#
#   sudo mkdir -p /etc/hadjchanges
#   sudo nano /etc/hadjchanges/api.env
#   sudo chmod 600 /etc/hadjchanges/api.env
#
# ⚠️ chmod 600 : ce fichier porte le mot de passe de la base et les secrets de
# signature des jetons. Lisible par tous, c'est une fuite qui ne se voit jamais.

NODE_ENV=production
PORT=3061

# ── Base PostgreSQL — Supabase ──────────────────────────────────────────────
# Tableau de bord Supabase → Connect → « Connection string ».
#
# ⚠️ DEUX chaînes, et chez Supabase elles se distinguent par le PORT, pas par
# un fragment « -pooler » comme chez Neon :
#
#   DATABASE_URL  → Transaction pooler, port 6543, + « ?pgbouncer=true »
#   DIRECT_URL    → Direct connection,  port 5432
#
# `prisma migrate deploy` crée des verrous consultatifs que pgBouncer ne sait
# pas relayer. Les migrations tournant au démarrage, une DIRECT_URL sur le 6543
# ne donne pas une erreur de migration : l'API ne démarre pas du tout.
DATABASE_URL=postgresql://postgres.<ref>:MOTDEPASSE@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.<ref>:MOTDEPASSE@aws-0-<region>.pooler.supabase.com:5432/postgres

# ── Jetons ──────────────────────────────────────────────────────────────────
# DEUX valeurs DIFFÉRENTES : openssl rand -base64 48
# La même des deux côtés permettrait de forger un jeton d'accès à partir d'un
# jeton de rafraîchissement.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ── Origine autorisée ───────────────────────────────────────────────────────
# Le tableau de bord, avec son schéma. L'application mobile n'envoie pas
# d'en-tête Origin : elle n'est pas concernée.
CORS_ORIGINS=https://change.preventic-afric.com

# ── Stockage des pièces d'identité et reçus ─────────────────────────────────
# ⚠️ GARDER `s3`. Le VPS appartient au CLIENT : `local` déposerait les pièces
# d'identité et les reçus de vos clients sur une machine dont vous ne maîtrisez
# ni l'accès, ni la durée de vie, ni la fin de contrat. R2 les garde chez vous.
# Même raisonnement que pour la base, et pour les mêmes raisons.
STORAGE_DRIVER=s3
S3_ENDPOINT=https://<id-compte>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── Courriel ────────────────────────────────────────────────────────────────
# ⚠️ sandbox.smtp.mailtrap.io CAPTURE sans livrer : aucun client ne recevrait
# rien. live.smtp.mailtrap.io (587) envoie réellement.
SMTP_HOST=live.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=HadjChanges <no-reply@preventic-afric.com>
