# Secrets de l'API HadjChanges — à déposer en /etc/hadjchanges/api.env
#
#   sudo mkdir -p /etc/hadjchanges
#   sudo nano /etc/hadjchanges/api.env
#   sudo chmod 600 /etc/hadjchanges/api.env
#
# ⚠️ chmod 600 : ce fichier porte le mot de passe de la base et les secrets de
# signature des jetons. Lisible par tous, c'est une fuite qui ne se voit jamais.

NODE_ENV=production
PORT=3061

# ── Base PostgreSQL locale au VPS ───────────────────────────────────────────
# Pas de pooleur en local : DIRECT_URL est la MÊME adresse. Les deux variables
# existent pour Neon, où elles diffèrent.
DATABASE_URL=postgresql://hadjchanges:MOTDEPASSE@127.0.0.1:5432/hadjchanges?schema=public
DIRECT_URL=postgresql://hadjchanges:MOTDEPASSE@127.0.0.1:5432/hadjchanges?schema=public

# ── Jetons ──────────────────────────────────────────────────────────────────
# DEUX valeurs DIFFÉRENTES : openssl rand -base64 48
# La même des deux côtés permettrait de forger un jeton d'accès à partir d'un
# jeton de rafraîchissement.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ── Origine autorisée ───────────────────────────────────────────────────────
# Le tableau de bord, avec son schéma. L'application mobile n'envoie pas
# d'en-tête Origin : elle n'est pas concernée.
CORS_ORIGINS=https://change.preventic-afric.com

# ── Stockage des pièces d'identité et reçus ─────────────────────────────────
# `local` écrit dans api/uploads sur le VPS : acceptable ici (le disque
# persiste, contrairement à un conteneur), mais À SAUVEGARDER au même titre que
# la base — ce sont des pièces de conformité KYC.
# `s3` les envoie sur Cloudflare R2, hors de la machine : préférable.
STORAGE_DRIVER=s3
S3_ENDPOINT=https://<id-compte>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── Courriel ────────────────────────────────────────────────────────────────
# ⚠️ sandbox.smtp.mailtrap.io CAPTURE sans livrer : aucun client ne recevrait
# rien. live.smtp.mailtrap.io (587) envoie réellement.
SMTP_HOST=live.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=HadjChanges <no-reply@preventic-afric.com>
