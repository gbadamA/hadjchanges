# ── Domaines ────────────────────────────────────────────────────────────────
# Deux enregistrements A doivent pointer vers l'IP du VPS AVANT le premier
# démarrage : Caddy demande les certificats aussitôt et échoue si le DNS ne
# résout pas encore. Let's Encrypt limite à 5 échecs par heure et par domaine.
DOMAINE_API=api.hadjchanges.ci
DOMAINE_ADMIN=admin.hadjchanges.ci

# ── Base de données (sur le VPS) ────────────────────────────────────────────
# La base tourne dans un conteneur, joignable uniquement depuis le réseau
# interne de Docker. Aucun port n'est publié vers l'extérieur.
#
# ⚠️ Mot de passe FORT et propre à cette machine. Le générer :
#   openssl rand -base64 24
POSTGRES_USER=hadjchanges
POSTGRES_PASSWORD=
POSTGRES_DB=hadjchanges
#
# `DATABASE_URL` et `DIRECT_URL` ne sont PAS à renseigner ici : le compose les
# construit à partir des trois valeurs ci-dessus. Sans pooleur local, les deux
# adresses sont identiques.

# ── Secrets JWT ─────────────────────────────────────────────────────────────
# DEUX valeurs DIFFÉRENTES, 32 caractères minimum. Les générer avec :
#   openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ── Paiements ───────────────────────────────────────────────────────────────
# En production, `simulation` REFUSE de démarrer, sauf démonstration déclarée
# (PAYMENT_DEMO=true : bandeau « DÉMONSTRATION » sur le tableau de bord).
# Paiements réels : PAYMENT_DRIVER=wave + les deux clés, et PAYMENT_DEMO=false,
# puis `docker compose build admin` (le bandeau est figé à la construction).
PAYMENT_DRIVER=simulation
PAYMENT_DEMO=false
WAVE_API_KEY=
WAVE_WEBHOOK_SECRET=

# ── Seed (une seule fois : docker compose --profile seed run --rm seed) ─────
SEED_ADMIN_PASSWORD=
SEED_CLIENT_PASSWORD=

# ── Stockage des pièces d'identité et reçus ─────────────────────────────────
# Sur un VPS, un volume Docker suffirait techniquement — mais il vit et meurt
# avec le serveur. S3/R2 garde ces pièces de conformité hors de la machine.
STORAGE_DRIVER=s3
S3_ENDPOINT=https://<id-compte>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── Courriel ────────────────────────────────────────────────────────────────
# ⚠️ `sandbox.smtp.mailtrap.io` CAPTURE sans livrer : parfait pour tester, mais
# en production aucun client ne recevrait rien.
SMTP_HOST=live.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=HadjChanges <no-reply@hadjchanges.ci>
